# Salin file ini menjadi .env dan isi nilai sesuai environment kamu.
# .env tidak pernah di-commit (lihat .gitignore).

# Koneksi database (wajib, dibaca oleh Prisma)
DATABASE_URL="mysql://user:password@localhost:3306/paskatema"

# Secret untuk menandatangani & memverifikasi JWT (WAJIB, minimal 16 karakter).
# Aplikasi akan gagal start jika variabel ini tidak diisi — jangan pernah
# memakai nilai contoh di bawah ini di lingkungan production.
JWT_SECRET="ganti-dengan-random-string-panjang-dan-rahasia"

# Masa berlaku token JWT (opsional, default "7d"). Format sesuai paket `ms`,
# contoh: "15m", "1h", "7d".
JWT_EXPIRES_IN="7d"

# Port HTTP server (opsional, default 3000)
PORT=3000
