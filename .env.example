# Salin file ini menjadi .env dan isi nilai sesuai environment kamu.
# .env tidak pernah di-commit (lihat .gitignore).

# Koneksi database PostgreSQL (wajib, dibaca oleh Prisma).
# Lokal: host "localhost". Deploy via docker-compose.yml (join network
# postgresql-wsnb_default yang sudah ada di VPS): host container Postgres-nya,
# yaitu "postgresql-wsnb-postgresql-1".
DATABASE_URL="postgresql://user:password@localhost:5432/paskatema"

# Secret untuk menandatangani & memverifikasi JWT (WAJIB, minimal 16 karakter).
# Aplikasi akan gagal start jika variabel ini tidak diisi — jangan pernah
# memakai nilai contoh di bawah ini di lingkungan production.
JWT_SECRET="ganti-dengan-random-string-panjang-dan-rahasia"

# Masa berlaku token JWT (opsional, default "7d"). Format sesuai paket `ms`,
# contoh: "15m", "1h", "7d".
JWT_EXPIRES_IN="7d"

# Port HTTP server (opsional, default 3000)
PORT=3000

# Redis (WAJIB — dipakai untuk cache response GET publik dan storage
# rate-limiting endpoint auth). Aplikasi gagal start kalau REDIS_HOST kosong.
# Lokal: host "localhost". Deploy via docker-compose.yml (join network
# redis_public yang sudah ada di VPS): host container Redis-nya, yaitu
# "redis_shared".
REDIS_HOST="localhost"
REDIS_PORT=6379
# Redis di VPS butuh auth (dikonfirmasi lewat `redis-cli PING` -> NOAUTH) —
# isi dengan password Redis yang sebenarnya, jangan dikosongkan untuk deploy VPS.
REDIS_PASSWORD="ganti-dengan-password-redis"
REDIS_DB=0

# Penyimpanan foto (opsional). Kosong = foto disimpan lokal di uploads/.
# Isi salah satu cara di bawah untuk memindahkan foto BARU ke Cloudinary
# (foto lama yang sudah tersimpan lokal tetap berfungsi). PDF E-Book tetap lokal.
# Cara 1 — satu URL dari dashboard Cloudinary (Settings > API Keys):
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
# Cara 2 — tiga variabel terpisah:
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# Folder di Cloudinary (opsional, default "paskatema"):
# CLOUDINARY_FOLDER="paskatema"
